FROM python:3.13-alpine

ARG APP_REVISION=unknown
ARG APP_BUILD_DATE=unknown
ARG MIGRATION_MANIFEST="{}"

LABEL org.opencontainers.image.title="LSF Fliegerlager Updater" \
      org.opencontainers.image.revision="${APP_REVISION}" \
      org.opencontainers.image.created="${APP_BUILD_DATE}" \
      io.lsf-fliegerlager.migrations="${MIGRATION_MANIFEST}"

RUN apk add --no-cache postgresql-client

COPY requirements-updater.txt /tmp/requirements-updater.txt
RUN pip install --no-cache-dir -r /tmp/requirements-updater.txt

WORKDIR /opt/updater
COPY deployment_agent.py .

ENV PYTHONUNBUFFERED=1

EXPOSE 8080
CMD ["python", "deployment_agent.py"]
